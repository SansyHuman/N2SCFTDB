      <item row="1" column="0"><widget class="QLabel" name="coulombMaxDimensionLabel"><property name="text"><string>Coulomb index maximum dimension</string></property><property name="buddy"><cstring>coulombMaxDimensionEdit</cstring></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="coulombMaxDimensionEdit"><property name="toolTip"><string>Highest included scaling dimension. Enter a nonnegative integer or exact fraction, such as 90 or 6/5.</string></property><property name="text"><string>90</string></property><property name="placeholderText"><string>Integer or fraction, e.g. 90 or 6/5</string></property></widget></item>
      <item row="2" column="0" colspan="2"><widget class="QLabel" name="indexCutoffHint"><property name="text"><string>Both cutoffs are inclusive: power of t for the full index, scaling dimension for the Coulomb index.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>

                <property name="accessibleName"><string>Seed theory gauge groups in Cartan notation</string></property>
                <property name="placeholderText"><string>e.g. A1; A2, C2; &quot;A1, A1&quot;</string></property>
                <property name="toolTip"><string>Enter Cartan types. Commas join factors of a product gauge group. Double quotes require exactly that gauge group; unquoted expressions require all listed factors. Semicolons separate alternatives, any one of which may match. Leave empty for no gauge-group restriction.</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLabel" name="searchSeedHelpLabel">
                <property name="text"><string>Use Cartan types: A1 for a single group, A1, C2 for a product. Double quotes, as in &quot;A1, C2&quot;, require an exact gauge group; unquoted expressions match theories containing all listed factors. Separate alternatives with semicolons; matching any alternative is sufficient.</string></property>
                <property name="wordWrap"><bool>true</bool></property>
               </widget>
              </item>
             </layout>
